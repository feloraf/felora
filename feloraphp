#!/usr/bin/env bash

CONTAINER_NAME=feloraphp
# Absolute path of this script
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

DOCKER_DIR="$SCRIPT_DIR/docker"
COMPOSE_FILE="$SCRIPT_DIR/src/app/compose.yaml"

COMMAND="$1"
shift 1 # remove first arg so remaining args become options

case "$COMMAND" in
    build)
        echo "Building Docker image..."
        docker build "$DOCKER_DIR" --tag $CONTAINER_NAME/swoole "$@"
        ;;

    up)
        echo "Starting docker compose..."
        docker compose -f "$COMPOSE_FILE" up "$@"
        ;;

    down)
        echo "Stopping docker compose..."
        docker compose -f "$COMPOSE_FILE" down "$@"
        ;;

    --help|"")
        echo "Usage: $CONTAINER_NAME <command> [options]"
        echo ""
        echo "Commands:"
        echo "  build                 Build the Docker image ($CONTAINER_NAME/swoole)"
        echo "  up [options]          docker compose up (e.g. -d)"
        echo "  down [options]        docker compose down (e.g. --remove-orphans)"
        echo "  --help                Show this help"
        echo ""
        echo "Examples:"
        echo "  $CONTAINER_NAME build"
        echo "  $CONTAINER_NAME up -d"
        echo "  $CONTAINER_NAME down --remove-orphans"
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo "Use --help for usage."
        exit 1
        ;;
esac
