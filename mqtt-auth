#!/usr/bin/env bash

# Absolute path of this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

DOCKER_DIR="$SCRIPT_DIR/docker"
COMPOSE_FILE="$SCRIPT_DIR/app/compose.yaml"

COMMAND="$1"
shift 1 # remove first arg so remaining args become options

case "$COMMAND" in
    build)
        echo "Building Docker image..."
        docker build "$DOCKER_DIR" --tag mqtt-auth/swoole "$@"
        ;;

    up)
        echo "Starting docker compose..."
        docker compose -f "$COMPOSE_FILE" up "$@"
        ;;

    down)
        echo "Stopping docker compose..."
        docker compose -f "$COMPOSE_FILE" down "$@"
        ;;

    --help|"")
        echo "Usage: mqtt-auth <command> [options]"
        echo ""
        echo "Commands:"
        echo "  build                 Build the Docker image (mqtt-auth/swoole)"
        echo "  up [options]          docker compose up (e.g. -d)"
        echo "  down [options]        docker compose down (e.g. --remove-orphans)"
        echo "  --help                Show this help"
        echo ""
        echo "Examples:"
        echo "  mqtt-auth build"
        echo "  mqtt-auth up -d"
        echo "  mqtt-auth down --remove-orphans"
        ;;

    *)
        echo "Unknown command: $COMMAND"
        echo "Use --help for usage."
        exit 1
        ;;
esac
